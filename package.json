{
  "name": "@senguoyun/dsh-arkme",
  "version": "0.1.1",
  "description": "Jotmo login and send-to-self sidebar integration for DeepSeek Harness",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./sdk": {
      "types": "./lib/types/sdk/index.d.ts",
      "default": "./lib/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/desktop_call",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run bundle",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly",
    "bundle": "tsdown",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:call-assets": "node scripts/verify-call-assets.mjs",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "ali-oss": "6.23.0",
    "qrcode-generator": "2.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../dsh-worktrees/jotmo-virtual-workspace/vendor/cordis",
    "@deepseek-ai/dsh-attachment": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/attachment/attachment",
    "@deepseek-ai/dsh-client-runtime": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-layout": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-settings": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/client/ui-slots",
    "@deepseek-ai/dsh-host-webserver": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/host/webserver",
    "@deepseek-ai/dsh-llm": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/llm/llm",
    "@deepseek-ai/dsh-system-prompt": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../dsh-worktrees/jotmo-virtual-workspace/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../dsh-worktrees/jotmo-virtual-workspace/vendor/schemastery",
    "@types/node": "22.20.0",
    "@types/ali-oss": "6.16.11",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}

{
  "name": "@senguoyun/dsh-arkme",
  "version": "0.1.39",
  "description": "Arkme account, records, chat and interwoven-moments integration for DeepSeek Harness",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkme-senx/arkme-dsh-plugin.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./sdk": {
      "types": "./lib/types/sdk/index.d.ts",
      "default": "./lib/sdk.js"
    },
    "./persistent-extension": {
      "types": "./lib/types/extensions/persistent-runtime.d.ts",
      "default": "./lib/persistent-extension.js"
    },
    "./bundle-runtime": {
      "types": "./lib/types/extensions/bundle-runtime.d.ts",
      "default": "./lib/bundle-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/desktop_call",
    "assets/windows/arkme-credential-helper.exe",
    "assets/windows/manifest.json",
    "cordis.patch.yml",
    "README.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "arkme": {
    "updateNotice": {
      "schemaVersion": 1,
      "level": "normal",
      "title": "Arkme 插件 0.1.39 更新",
      "summary": "Dev to master",
      "publishedAt": "2026-09-01T12:48:29.808Z",
      "releaseNotesUrl": "https://github.com/arkme-senx/arkme-dsh-plugin/releases/tag/v0.1.39"
    }
  },
  "scripts": {
    "build": "pnpm run verify:windows-credential-helper && pnpm run clean:build && pnpm run build:types && pnpm run bundle",
    "build:windows-credential-helper": "node scripts/build-windows-credential-helper.mjs",
    "clean:build": "node scripts/clean-lib.mjs",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly",
    "bundle": "node scripts/clean-bundle.mjs && tsdown && node scripts/verify-executable-entrypoints.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:runtime": "node scripts/build-runtime-artifact.mjs",
    "verify:call-assets": "node scripts/verify-call-assets.mjs",
    "verify:windows-credential-helper": "node scripts/verify-windows-credential-helper.mjs",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "ali-oss": "6.23.0",
    "jsqr": "1.4.0",
    "mediabunny": "1.55.2",
    "pinyin-pro": "3.29.3",
    "qrcode-generator": "2.0.4",
    "semver": "7.8.5",
    "sharp": "0.35.3",
    "ws": "8.18.3",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5 || ^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",

{
  "name": "@senguoyun/dsh-arkme",
  "version": "0.2.18",
  "description": "Arkme account, records, chat and interwoven-moments integration for DeepSeek Harness",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./sdk": {
      "types": "./lib/types/sdk/index.d.ts",
      "default": "./lib/sdk.js"
    },
    "./persistent-extension": {
      "types": "./lib/types/extensions/persistent-runtime.d.ts",
      "default": "./lib/persistent-extension.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/desktop_call",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "arkme": {
    "updateNotice": {
      "schemaVersion": 1,
      "level": "normal",
      "title": "Arkme 插件 0.1.6 更新",
      "summary": "修复每次进入 App 的更新检查与自动升级，并解除扩展安装的对话限制。",
      "publishedAt": "2026-08-19T12:57:17.000Z",
      "releaseNotesUrl": "https://www.npmjs.com/package/@senguoyun/dsh-arkme"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run bundle",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly",
    "bundle": "tsdown",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:call-assets": "node scripts/verify-call-assets.mjs",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "ali-oss": "6.23.0",
    "qrcode-generator": "2.0.4",
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-schema-form": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/ali-oss": "6.16.11",
    "@types/node": "22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/semver": "7.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}

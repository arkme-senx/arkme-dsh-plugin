{
  "name": "@senguoyun/dsh-arkme",
  "version": "3.0.26",
  "description": "Arkme account, records, chat and interwoven-moments integration for DeepSeek Harness",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkme-senx/arkme-dsh-plugin.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./sdk": {
      "types": "./lib/types/sdk/index.d.ts",
      "default": "./lib/sdk.js"
    },
    "./persistent-extension": {
      "types": "./lib/types/extensions/persistent-runtime.d.ts",
      "default": "./lib/persistent-extension.js"
    },
    "./bundle-runtime": {
      "types": "./lib/types/extensions/bundle-runtime.d.ts",
      "default": "./lib/bundle-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/desktop_call",
    "assets/licenses/MaterialIcons_LICENSE.txt",
    "assets/licenses/DSH_QueueDock_LICENSE.txt",
    "assets/windows/arkme-credential-helper.exe",
    "assets/windows/manifest.json",
    "cordis.patch.yml",
    "README.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "arkme": {
    "desktopAccountScope": {
      "version": 1
    },
    "desktopHarnessReady": {
      "version": 1
    },
    "updateNotice": {
      "schemaVersion": 1,
      "level": "normal",
      "title": "Arkme 插件 3.0.26 更新",
      "summary": "增加手动说话人目录，优化录音布局并同步 DSH 文字标记",
      "publishedAt": "2026-10-23T07:10:07.788Z",
      "releaseNotesUrl": "https://github.com/arkme-senx/arkme-dsh-plugin/releases/tag/v3.0.26"
    }
  },
  "scripts": {
    "build": "pnpm run verify:windows-credential-helper && pnpm run clean:build && pnpm run build:types && pnpm run bundle",
    "build:windows-credential-helper": "node scripts/build-windows-credential-helper.mjs",
    "clean:build": "node scripts/clean-lib.mjs",
    "build:types": "tsc --project tsconfig.json --emitDeclarationOnly",
    "bundle": "node scripts/clean-bundle.mjs && tsdown && node scripts/verify-executable-entrypoints.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:runtime": "node scripts/build-runtime-artifact.mjs",
    "verify:call-assets": "node scripts/verify-call-assets.mjs",
    "verify:windows-credential-helper": "node scripts/verify-windows-credential-helper.mjs",
    "prepare": "node scripts/prepare-build.mjs",
    "typecheck:harness-host": "tsc --project tsconfig.harness-host.json --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@rc-component/tour": "2.4.0",
